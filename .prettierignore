# The payload ships byte-identical to what lands in a user's repo. Formatting it
# here would silently rewrite other people's docs and skills.
templates/

# This repo's live copy of the skills, asserted byte-equal to templates/skills/
# by a test. Formatting one side and not the other would break that.
.claude/

# The engine this repo vendored into itself by running its own init. Same
# byte-equality reason as .claude/.
scripts/

# The engine writes these tables and then checks them for drift. A formatter
# rewrapping one is indistinguishable from a stale table, so roadmap-check
# fails. Any project using both prettier and msg-roadmap needs these four lines.
docs/roadmap/
docs/tasks/
docs/explorations/
docs/ditched/

# Golden output trees are compared byte-for-byte against engine output.
test/fixtures/

dist/
node_modules/
