{
  "name": "@lucas-gomide/msg-cli",
  "version": "0.1.0",
  "description": "Scaffold the msg planning workflow — skills, standards docs and the roadmap sync engine — into any project.",
  "keywords": [
    "claude",
    "claude-code",
    "skills",
    "scaffold",
    "roadmap",
    "planning"
  ],
  "license": "MIT",
  "author": "Lucas Gomide",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "msg": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.js.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
